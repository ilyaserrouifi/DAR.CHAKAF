# Base de données Neon / PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret utilisé pour signer les tokens JWT admin (générez le vôtre, ne le partagez jamais)
JWT_SECRET=change-me-generate-a-random-64-char-secret

NODE_ENV=production
